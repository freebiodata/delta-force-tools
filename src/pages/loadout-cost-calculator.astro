---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import TrustBlock from '../components/TrustBlock.astro';
import ToolSchema from '../components/ToolSchema.astro';

const title = 'Loadout Cost Calculator – Delta Force | DF TOOLS';
const description =
  'Free Delta Force loadout cost calculator: add weapons, armor, ammo and meds line by line to see your full kit price and stay under budget before you deploy.';

const faqs = [
  {
    q: 'How much should a raid loadout cost?',
    a: 'A common rule: kit cost should be a fraction of the loot you realistically extract with — if you break even around 40–60k of loot, a 60k kit needs a good raid to pay off. Run the result through the <a href="/extraction-profit-calculator/">extraction profit calculator</a> with your real extraction rate for a personal answer.',
  },
  {
    q: 'Should ammo be part of the budget?',
    a: 'Yes — ammo is the budget line most players underestimate. High-tier rounds can cost more than the gun firing them. Count every loaded mag plus reserves.',
  },
  {
    q: 'What about insurance premiums?',
    a: 'Add them on the extraction profit calculator, where they feed the expected-value math. Here, keep the number to what you pay at the deploy screen.',
  },
];
---

<Base title={title} description={description}>
  <Breadcrumbs items={[{ name: 'Tools', href: '/tools/' }, { name: 'Loadout Cost Calculator' }]} />
  <ToolSchema tool="Delta Force Loadout Cost Calculator" description={description} />

  <div class="page-head">
    <h1>Loadout Cost Calculator</h1>
    <div class="h1-bar"></div>
    <p class="lede">
      Line-by-line kit pricing: weapons, plates, mags, meds, throwables. See the full deploy-screen number and how
      much budget you have left before you press deploy.
    </p>
    <div class="microline"><span>Free</span><span>No sign-up</span><span>Runs in your browser</span></div>
  </div>

  <form class="tool panel" id="loadout" autocomplete="off" onsubmit="return false">
    <div class="fields">
      <label class="field"><span>Primary weapon</span><input id="w1" type="number" value="32000" min="0" step="500" inputmode="numeric" /></label>
      <label class="field"><span>Secondary / sidearm</span><input id="w2" type="number" value="9000" min="0" step="500" inputmode="numeric" /></label>
      <label class="field"><span>Armor + helmet</span><input id="arm" type="number" value="18000" min="0" step="500" inputmode="numeric" /></label>
      <label class="field"><span>Mags of ammo loaded</span><input id="mags" type="number" value="5" min="0" step="1" inputmode="numeric" /><small>Total mags carried</small></label>
      <label class="field"><span>Cost per mag</span><input id="magcost" type="number" value="2400" min="0" step="100" inputmode="numeric" /></label>
      <label class="field"><span>Meds + throwables</span><input id="meds" type="number" value="6000" min="0" step="500" inputmode="numeric" /></label>
      <label class="field"><span>Rig + backpack</span><input id="rig" type="number" value="5000" min="0" step="500" inputmode="numeric" /></label>
      <label class="field"><span>My budget cap</span><input id="budget" type="number" value="80000" min="0" step="1000" inputmode="numeric" /><small>0 = skip verdict</small></label>
    </div>
    <button class="btn" type="button" onclick="computeLoadout()">Total it up</button>
  </form>

  <div class="result" id="result" aria-live="polite"></div>

  <section class="prose">
    <h2>How it works</h2>
    <pre class="formula">total = primary + secondary + armor + meds + rig
      + (mags × cost per mag)</pre>
    <p>Everything is an input — nothing is looked up — so the total always matches what your deploy screen shows. Prices you enter stay in your browser; see <a href="/privacy/">privacy</a>.</p>

    <h2>FAQ</h2>
    <Faq faqs={faqs} />
  </section>

  <section class="prose">
    <h2>Related tools and guides</h2>
    <div class="cards">
      <a class="card" href="/extraction-profit-calculator/"><span class="ico">💰</span><h3>Extraction Profit Calculator</h3><p>Does this kit pay for itself at your extraction rate?</p><span class="tag">Calculator</span></a>
      <a class="card" href="/ammo-chart/"><span class="ico">🧭</span><h3>Ammo Chart</h3><p>Pick the cheapest tier that still kills what you'll meet.</p><span class="tag">Chart</span></a>
      <a class="card" href="/guides/extraction-profit-guide/"><span class="ico">📘</span><h3>Raid Profit Basics</h3><p>Budget discipline, loot discipline, and when to run cheap.</p><span class="tag">Guide</span></a>
    </div>
  </section>

  <TrustBlock tool="Loadout Cost Calculator" />
</Base>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string, fallback = 0) => {
    const v = parseFloat($(id)?.value);
    return Number.isFinite(v) ? v : fallback;
  };
  const money = (n: number) =>
    Number.isFinite(n) ? new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(Math.round(n)) : '—';

  function computeLoadout() {
    const total = num('w1') + num('w2') + num('arm') + num('meds') + num('rig') + num('mags') * num('magcost');
    const ammoTotal = num('mags') * num('magcost');
    const budget = num('budget');
    const over = total - budget;
    let verdict = '';
    if (budget > 0) {
      verdict = over <= 0
        ? `<div class="verdict ok">✅ ${money(-over)} under your ${money(budget)} budget.</div>`
        : `<div class="verdict bad">❌ ${money(over)} over your ${money(budget)} budget — drop a mag or downgrade the plate.</div>`;
    }
    const el = document.getElementById('result')!;
    el.innerHTML = `
      <div class="stats">
        <div class="stat"><span class="k">Full kit cost</span><span class="v">${money(total)}</span></div>
        <div class="stat"><span class="k">Of which ammo</span><span class="v">${money(ammoTotal)}</span></div>
        <div class="stat"><span class="k">Ammo share of kit</span><span class="v">${total > 0 ? money((ammoTotal / total) * 100) + '%' : '—'}</span></div>
      </div>
      ${verdict}
      <p class="note">Ammo over ~35% of kit cost usually means you are over-tiered for the lobbies you face — cross-check the <a href="/ammo-chart/">ammo chart</a>.</p>`;
    (window as any).computeLoadout = computeLoadout;
  }

  (window as any).computeLoadout = computeLoadout;
  document.getElementById('loadout')?.addEventListener('input', computeLoadout);
  computeLoadout();
</script>
