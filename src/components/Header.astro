---
const { pathname } = Astro.url;
const links = [
  { href: '/tools/', label: 'Tools' },
  { href: '/ammo-chart/', label: 'Ammo Chart' },
  { href: '/guides/how-ttk-works/', label: 'Guides' },
  { href: '/about/', label: 'About' },
];
const current = (href: string) =>
  href === '/tools/' ? pathname.startsWith('/ttk') || pathname === '/tools/' : pathname.startsWith(href);
---

<header class="site-head">
  <div class="wrap head-row">
    <a class="brand" href="/">
      <svg width="22" height="22" viewBox="0 0 64 64" aria-hidden="true">
        <circle cx="32" cy="32" r="17" fill="none" stroke="#e8a33d" stroke-width="5"></circle>
        <line x1="32" y1="4" x2="32" y2="20" stroke="#e8a33d" stroke-width="5"></line>
        <line x1="32" y1="44" x2="32" y2="60" stroke="#e8a33d" stroke-width="5"></line>
        <line x1="4" y1="32" x2="20" y2="32" stroke="#e8a33d" stroke-width="5"></line>
        <line x1="44" y1="32" x2="60" y2="32" stroke="#e8a33d" stroke-width="5"></line>
      </svg>
      DF<span class="slash">//</span>TOOLS
    </a>
    <nav class="site-nav" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
