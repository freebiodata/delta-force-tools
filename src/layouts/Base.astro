---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/game';

interface Props {
  title: string;
  description: string;
  /** JSON-LD schema objects to embed */
  schema?: Record<string, unknown>[];
  robots?: string;
  noindex?: boolean;
}

const { title, description, schema = [], robots, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const robotsContent = robots ?? (noindex ? 'noindex, nofollow' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <meta name="theme-color" content="#0b0e0c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:image" content={new URL('/og-default.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-default.png', Astro.site)} />
    {schema.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
